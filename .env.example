# Copy to .env (never commit .env)

# Discord — multi-tier routing (create separate channels for each tier)
# Priority: OpenAI, Anthropic, Databricks, Snowflake, Nvidia, Scale AI, etc.
DISCORD_WEBHOOK_PRIORITY=
# Fortune500: Large employers not in Priority (banks, industrials, big tech adjacent)
DISCORD_WEBHOOK_FORTUNE500=
# Other: Everything else that passes alert gates
DISCORD_WEBHOOK_OTHER=
# Legacy fallback for all tiers (if tier-specific URL not set)
DISCORD_WEBHOOK_URL=

# Phone push — free (replaces Twilio). Pick ONE or both.
# ntfy: install the ntfy app, subscribe to your secret topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=   # only if you use a private/auth server

# Telegram (optional free alternative)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Gmail (desktop OAuth JSON files)
GMAIL_CLIENT_SECRETS=secrets/gmail-client.json
GMAIL_TOKEN=secrets/gmail-token.json

# Grok Bot webhooks (optional)
GROK_BOT_WEBHOOK_DIRECTOR=
GROK_BOT_KEY_DIRECTOR=
GROK_BOT_WEBHOOK_JOB_ANALYST=
GROK_BOT_KEY_JOB_ANALYST=
GROK_BOT_WEBHOOK_RESUME_MAPPER=
GROK_BOT_KEY_RESUME_MAPPER=
GROK_BOT_WEBHOOK_STRATEGIST=
GROK_BOT_KEY_STRATEGIST=
GROK_BOT_WEBHOOK_INBOX=
GROK_BOT_KEY_INBOX=
GROK_BOT_WEBHOOK_WEEKLY=
GROK_BOT_KEY_WEEKLY=

GROQ_API_KEY=
GITHUB_TOKEN=
JOBRADAR_RESUME_PATH=/Users/rohankilaru/Resume Bot/resumes/master.md

JOBRADAR_DB_PATH=data/jobradar.db
JOBRADAR_NOTIFY_MOCK_PATH=data/notifications.jsonl
JOBRADAR_SCAN_INTERVAL_SEC=300
JOBRADAR_NOTIFY_WINDOW_DAYS=14

# Link verification gate (default: 1 = on for real notifies; tests set 0)
# When enabled, probes URLs before notify. Broken/redirected links are skipped.
# See upcoming link-verification PR for CLI: `python -m jobradar verify-links`
JOBRADAR_LINK_PROBE=1
